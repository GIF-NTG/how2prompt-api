# Copy to .env.prod and fill real values:
#   cp .env.prod.example .env.prod
# Never commit .env.prod

# ---- Image / API ----
IMAGE_TAG=latest
API_PORT=8080
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Dspring.jpa.show-sql=false

# ---- Postgres ----
POSTGRES_DB=how2prompt
POSTGRES_USER=how2prompt
POSTGRES_PASSWORD=change-me-strong-db-password

# ---- Redis ----
REDIS_PASSWORD=change-me-strong-redis-password

# ---- RabbitMQ ----
RABBITMQ_USER=how2prompt
RABBITMQ_PASSWORD=change-me-strong-rabbitmq-password

# ---- JWT (required in prod) ----
# PEM with literal \n for newlines, e.g.:
# JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# ---- Auth / frontend ----
GOOGLE_CLIENT_ID=
AUTH_COOKIE_SECURE=true
AUTH_CORS_ORIGINS=https://app.how2prompt.example
FRONTEND_BASE_URL=https://app.how2prompt.example

# ---- SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@how2prompt.example
MAIL_FROM_NAME=How2Prompt
EMAIL_VERIFY_TTL=24h
EMAIL_RESEND_COOLDOWN=60s
